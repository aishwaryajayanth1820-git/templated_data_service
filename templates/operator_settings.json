{
  "$schema": "../schema/tds-template.schema.json",
  "grammar": "tds/v1",
  "name": "operator_settings",
  "label": "Operator Settings",
  "description": "Per-operator, per-jurisdiction game settings. Maintained by admins; read by everyone.",
  "manageType": "MANAGE_VIEW",
  "fields": [
    { "name": "id", "type": "id", "ui": { "placement": "hidden" } },
    {
      "name": "operator_name",
      "label": "Operator",
      "type": "string",
      "length": 255,
      "required": true,
      "constraints": { "notBlank": true },
      "ui": { "placement": "column", "widget": "text", "width": 220 }
    },
    {
      "name": "jurisdictional_name",
      "label": "Jurisdiction",
      "type": "string",
      "length": 255,
      "required": true,
      "constraints": { "notBlank": true },
      "ui": { "placement": "column", "widget": "text", "width": 200 }
    },
    {
      "name": "min_spin_time",
      "label": "Min spin time",
      "type": "double",
      "required": true,
      "constraints": { "min": 0, "max": 60 },
      "ui": { "placement": "column", "widget": "number", "width": 140, "format": "0.00 's'", "help": "Seconds" }
    }
  ],
  "indexes": [
    { "name": "ux_operator_jurisdiction", "fields": ["operator_name", "jurisdictional_name"], "unique": true }
  ],
  "access": {
    "admin": ["read", "create", "update", "delete"],
    "viewer": ["read"]
  },
  "view": {
    "titleField": "operator_name",
    "defaultSort": [{ "field": "operator_name", "dir": "asc" }, { "field": "jurisdictional_name", "dir": "asc" }],
    "pageSize": 25,
    "search": ["operator_name", "jurisdictional_name"],
    "filters": ["jurisdictional_name"]
  }
}
